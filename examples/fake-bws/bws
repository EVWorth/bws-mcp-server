#!/usr/bin/env bash
# Minimal stand-in for the `bws` CLI used by examples/probe-structured.py.
# Returns predictable JSON for list/get calls and exec's the argv for `run`.
# Refuses anything else with a non-zero exit so test failures are loud.

set -euo pipefail

FAKE_SECRETS='[{"id":"11111111-1111-1111-1111-111111111111","key":"alpha","projectId":null,"creationDate":"2026-01-01T00:00:00Z","revisionDate":"2026-01-01T00:00:00Z"},{"id":"22222222-2222-2222-2222-222222222222","key":"beta","projectId":null,"creationDate":"2026-01-02T00:00:00Z","revisionDate":"2026-01-02T00:00:00Z"}]'
FAKE_PROJECTS='[{"id":"33333333-3333-3333-3333-333333333333","name":"opencode"}]'
FAKE_SECRET='{"id":"11111111-1111-1111-1111-111111111111","key":"alpha","value":"<redacted>","projectId":null,"creationDate":"2026-01-01T00:00:00Z","revisionDate":"2026-01-01T00:00:00Z"}'
FAKE_PROJECT='{"id":"33333333-3333-3333-3333-333333333333","name":"opencode","creationDate":"2026-01-01T00:00:00Z","revisionDate":"2026-01-01T00:00:00Z"}'

# Write-tool responses (echo shape bws would return).
FAKE_CREATE_SECRET='{"id":"44444444-4444-4444-4444-444444444444","key":"new","value":"<redacted>","projectId":"33333333-3333-3333-3333-333333333333","creationDate":"2026-02-01T00:00:00Z","revisionDate":"2026-02-01T00:00:00Z"}'
FAKE_EDIT_SECRET='{"id":"11111111-1111-1111-1111-111111111111","key":"alpha","value":"<redacted>","projectId":null,"creationDate":"2026-01-01T00:00:00Z","revisionDate":"2026-02-15T00:00:00Z"}'
FAKE_DELETE_RESPONSE='{"ids":["11111111-1111-1111-1111-111111111111"],"deleted":1}'
FAKE_CREATE_PROJECT='{"id":"55555555-5555-5555-5555-555555555555","name":"new-project","creationDate":"2026-02-01T00:00:00Z","revisionDate":"2026-02-01T00:00:00Z"}'
FAKE_EDIT_PROJECT='{"id":"33333333-3333-3333-3333-333333333333","name":"renamed","creationDate":"2026-01-01T00:00:00Z","revisionDate":"2026-02-15T00:00:00Z"}'

if [[ "${1:-}" == "secret" && "${2:-}" == "list" ]]; then
    printf '%s\n' "$FAKE_SECRETS"
    exit 0
fi

if [[ "${1:-}" == "secret" && "${2:-}" == "get" ]]; then
    printf '%s\n' "$FAKE_SECRET"
    exit 0
fi

if [[ "${1:-}" == "secret" && "${2:-}" == "create" ]]; then
    printf '%s\n' "$FAKE_CREATE_SECRET"
    exit 0
fi

if [[ "${1:-}" == "secret" && "${2:-}" == "edit" ]]; then
    printf '%s\n' "$FAKE_EDIT_SECRET"
    exit 0
fi

if [[ "${1:-}" == "secret" && "${2:-}" == "delete" ]]; then
    printf '%s\n' "$FAKE_DELETE_RESPONSE"
    exit 0
fi

if [[ "${1:-}" == "project" && "${2:-}" == "list" ]]; then
    printf '%s\n' "$FAKE_PROJECTS"
    exit 0
fi

if [[ "${1:-}" == "project" && "${2:-}" == "get" ]]; then
    printf '%s\n' "$FAKE_PROJECT"
    exit 0
fi

if [[ "${1:-}" == "project" && "${2:-}" == "create" ]]; then
    printf '%s\n' "$FAKE_CREATE_PROJECT"
    exit 0
fi

if [[ "${1:-}" == "project" && "${2:-}" == "edit" ]]; then
    printf '%s\n' "$FAKE_EDIT_PROJECT"
    exit 0
fi

if [[ "${1:-}" == "project" && "${2:-}" == "delete" ]]; then
    printf '%s\n' "$FAKE_DELETE_RESPONSE"
    exit 0
fi

if [[ "${1:-}" == "run" ]]; then
    # Strip "run" and any flags up to "--", then exec the rest.
    shift
    while [[ $# -gt 0 && "$1" != "--" ]]; do shift; done
    if [[ $# -gt 0 && "$1" == "--" ]]; then shift; fi
    exec "$@"
fi

echo "fake-bws: unsupported invocation: $*" >&2
exit 2